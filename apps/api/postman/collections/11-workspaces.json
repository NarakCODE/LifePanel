                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/workspaces/resolve-context?workspaceId={{workspaceId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "workspaces",
                "resolve-context"
              ],
              "query": [
                {
                  "key": "workspaceId",
                  "value": "{{workspaceId}}"
                }
              ]
            }
          }
        }
      ]
