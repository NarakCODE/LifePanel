{
  "info": {
    "name": "10 - Dashboard",
    "description": "Dashboard aggregation and metric endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get Tasks Overview",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "x-workspace-id",
            "value": "{{workspaceId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/dashboard/tasks-overview",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "dashboard",
            "tasks-overview"
          ]
        }
      }
    }
  ]
}
