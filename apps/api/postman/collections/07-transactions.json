{
  "info": {
    "name": "07 - Transactions",
    "description": "Workspace-scoped transaction endpoints and summary queries.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create Transaction",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const response = pm.response.json();",
              "if (response.data?.id) {",
              "  pm.environment.set('transactionId', response.data.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "x-workspace-id",
            "value": "{{workspaceId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"budgetId\": \"{{budgetId}}\",\n  \"amount\": 45.5,\n  \"type\": \"expense\",\n  \"category\": \"food\",\n  \"description\": \"Weekly grocery shopping\",\n  \"date\": \"2026-03-20T00:00:00.000Z\",\n  \"currency\": \"USD\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/transactions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "transactions"
          ]
        }
      }
    },
    {
      "name": "List Transactions",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "x-workspace-id",
            "value": "{{workspaceId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/transactions?page=1&limit=20&type=expense&currency=USD",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "transactions"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "20"
            },
            {
              "key": "type",
              "value": "expense"
            },
            {
              "key": "currency",
              "value": "USD"
            }
          ]
        }
      }
    },
    {
      "name": "Get Transaction by ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "x-workspace-id",
            "value": "{{workspaceId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/transactions/{{transactionId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "transactions",
            "{{transactionId}}"
          ]
        }
      }
    },
    {
      "name": "Update Transaction",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "x-workspace-id",
            "value": "{{workspaceId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 49.99,\n  \"description\": \"Updated grocery shopping total\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/transactions/{{transactionId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "transactions",
            "{{transactionId}}"
          ]
        }
      }
    },
    {
      "name": "Delete Transaction",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "x-workspace-id",
            "value": "{{workspaceId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/transactions/{{transactionId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "transactions",
            "{{transactionId}}"
          ]
        }
      }
    },
    {
      "name": "Get Transaction Summary",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "x-workspace-id",
            "value": "{{workspaceId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/transactions/summary?dateFrom=2026-03-01T00:00:00.000Z&dateTo=2026-03-31T23:59:59.999Z&currency=USD",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "transactions",
            "summary"
          ],
          "query": [
            {
              "key": "dateFrom",
              "value": "2026-03-01T00:00:00.000Z"
            },
            {
              "key": "dateTo",
              "value": "2026-03-31T23:59:59.999Z"
            },
            {
              "key": "currency",
              "value": "USD"
            }
          ]
        }
      }
    },
    {
      "name": "Filter by Category",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "x-workspace-id",
            "value": "{{workspaceId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/transactions?category=food&page=1&limit=20",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "transactions"
          ],
          "query": [
            {
              "key": "category",
              "value": "food"
            },
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "20"
            }
          ]
        }
      }
    },
    {
      "name": "Filter by Date Range",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "x-workspace-id",
            "value": "{{workspaceId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/transactions?dateFrom=2026-03-01T00:00:00.000Z&dateTo=2026-03-31T23:59:59.999Z&page=1&limit=50",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "transactions"
          ],
          "query": [
            {
              "key": "dateFrom",
              "value": "2026-03-01T00:00:00.000Z"
            },
            {
              "key": "dateTo",
              "value": "2026-03-31T23:59:59.999Z"
            },
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "50"
            }
          ]
        }
      }
    }
  ]
}
