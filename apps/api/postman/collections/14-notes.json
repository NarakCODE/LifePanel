{
  "info": {
    "name": "14 - Notes",
    "description": "Notes management. Requires `x-workspace-id` header for workspace-scoped operations.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create Note",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "x-workspace-id",
            "value": "{{workspaceId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Strategy Meeting\",\n  \"projectId\": \"{{projectId}}\",\n  \"content\": \"Discussed Q3 goals and budget allocation.\",\n  \"noteType\": \"meeting\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/notes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "notes"
          ]
        }
      }
    },
    {
      "name": "Get Notes by Project",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "x-workspace-id",
            "value": "{{workspaceId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/notes/by-project/{{projectId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "notes",
            "by-project",
            "{{projectId}}"
          ]
        }
      }
    },
    {
      "name": "Get All Notes",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "x-workspace-id",
            "value": "{{workspaceId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/notes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "notes"
          ]
        }
      }
    },
    {
      "name": "Get Note by ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "x-workspace-id",
            "value": "{{workspaceId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/notes/{{noteId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "notes",
            "{{noteId}}"
          ]
        }
      }
    },
    {
      "name": "Update Note",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "x-workspace-id",
            "value": "{{workspaceId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Updated Strategy Meeting\",\n  \"content\": \"Revised Q3 goals and budget allocation.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/notes/{{noteId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "notes",
            "{{noteId}}"
          ]
        }
      }
    },
    {
      "name": "Delete Note",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "x-workspace-id",
            "value": "{{workspaceId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/notes/{{noteId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "notes",
            "{{noteId}}"
          ]
        }
      }
    }
  ]
}
