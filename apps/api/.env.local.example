# Redis Configuration
# Used for caching, distributed rate limiting, sessions, and pub/sub

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Cache TTL in seconds (default: 1 hour)
REDIS_TTL=3600

# Maximum connections in the pool
REDIS_MAX_CONNECTIONS=10

# Connection timeout in milliseconds
REDIS_CONNECTION_TIMEOUT=5000

# Rate limiting configuration (uses Redis storage)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
